{
  "appId": "nl.pidlane.app",
  "appName": "PidLane",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "url": "https://app.pidlane.nl",
    "cleartext": false,
    "errorPath": "error.html",
    "allowNavigation": [
      "app.pidlane.nl",
      "*.workers.dev"
    ]
  },
  "plugins": {
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "Zoeken naar OBD2 adapter...",
        "cancel": "Annuleren",
        "availableDevices": "Beschikbare adapters",
        "noDeviceFound": "Geen adapter gevonden"
      }
    }
  }
}

+  }
+
+  function isOpen() { return !!(_ov && _ov.classList.contains('plh-aan')); }
+
+  // ════════════════════════════════════════════════════════════════
+  //  DE UITROEPTEKENS
+  // ════════════════════════════════════════════════════════════════
+  function tipsAan() {
+    try { return localStorage.getItem(OPSLAG_TIPS) !== '0'; }
+    catch (e) { /* stil: opslag kan geblokkeerd zijn; dan staan ze aan */ return true; }
+  }
+
+  function zetTips(aan) {
